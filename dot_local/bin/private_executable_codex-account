#!/usr/bin/env bash

# Keep two Codex CLI logins locally and make the selected one the CLI default.
set -euo pipefail

profiles_root="${XDG_DATA_HOME:-$HOME/.local/share}/codex-accounts"
state_root="${XDG_STATE_HOME:-$HOME/.local/state}/codex-account"
codex_home="${CODEX_HOME:-$HOME/.codex}"
active_file="$state_root/active"
lock_file="$state_root/lock"

umask 077
mkdir -p "$profiles_root" "$state_root" "$codex_home"
exec 9>"$lock_file"
flock 9

valid_name() {
  [[ $1 =~ ^[a-z0-9][a-z0-9_-]*$ ]]
}

active_account() {
  if [[ -s $active_file ]]; then
    <"$active_file" tr -d '\n'
  else
    printf 'primary'
  fi
}

profile_auth() {
  printf '%s/%s/auth.json' "$profiles_root" "$1"
}

save_current() {
  local account="$1" destination
  destination="$(profile_auth "$account")"
  if [[ -s $codex_home/auth.json ]]; then
    mkdir -p "${destination%/*}"
    cp "$codex_home/auth.json" "$destination"
    chmod 600 "$destination"
  fi
}

refresh_widget() {
  omarchy-agent-usage-update --limits-only codex >/dev/null 2>&1 &
}

announce() {
  notify-send -a Codex -t 3500 "Codex account: $1" "$2"
}

initialize() {
  local account
  account="$(active_account)"
  valid_name "$account" || account="primary"
  save_current "$account"
  printf '%s\n' "$account" >"$active_file"
}

switch_to() {
  local account="$1" source previous
  valid_name "$account" || { printf 'Account names use lowercase letters, numbers, _ and -.\n' >&2; exit 2; }
  initialize
  previous="$(active_account)"
  source="$(profile_auth "$account")"
  if [[ ! -s $source ]]; then
    printf 'No saved login for %s. Starting Codex login.\n' "$account"
    exec "$0" login "$account"
  fi
  save_current "$previous"
  cp "$source" "$codex_home/auth.json"
  chmod 600 "$codex_home/auth.json"
  printf '%s\n' "$account" >"$active_file"
  refresh_widget
  announce "$account" "Codex CLI and the usage widget now use this account."
}

login() {
  local account="$1" current backup status
  valid_name "$account" || { printf 'Account names use lowercase letters, numbers, _ and -.\n' >&2; exit 2; }
  initialize
  current="$(active_account)"
  save_current "$current"
  backup="$codex_home/auth.json.codex-account-backup"
  rm -f "$backup"
  [[ ! -f $codex_home/auth.json ]] || mv "$codex_home/auth.json" "$backup"
  trap '[[ ! -f "$codex_home/auth.json" && -f "$backup" ]] && mv "$backup" "$codex_home/auth.json"' EXIT
  printf 'Sign in to the %s Codex account, then exit Codex.\n' "$account"
  if mise x codex -- codex login; then
    status=0
  else
    status=$?
  fi
  if [[ $status -ne 0 || ! -s $codex_home/auth.json ]]; then
    printf 'Codex login did not complete; restored %s.\n' "$current" >&2
    exit 1
  fi
  save_current "$account"
  printf '%s\n' "$account" >"$active_file"
  rm -f "$backup"
  trap - EXIT
  refresh_widget
  announce "$account" "Codex CLI and the usage widget now use this account."
}

toggle() {
  initialize
  local current next
  current="$(active_account)"
  next="secondary"
  [[ $current == "secondary" ]] && next="primary"
  if [[ ! -s $(profile_auth "$next") ]]; then
    announce "$next" "A terminal is opening for its one-time Codex login."
    setsid uwsm-app -- xdg-terminal-exec -e "$0" login "$next" >/dev/null 2>&1 &
    return
  fi
  switch_to "$next"
}

case "${1:-status}" in
  status)
    initialize
    printf '%s\n' "$(active_account)"
    ;;
  switch)
    [[ $# -eq 2 ]] || { printf 'Usage: codex-account switch <name>\n' >&2; exit 2; }
    switch_to "$2"
    ;;
  login)
    [[ $# -eq 2 ]] || { printf 'Usage: codex-account login <name>\n' >&2; exit 2; }
    login "$2"
    ;;
  toggle)
    toggle
    ;;
  *)
    printf 'Usage: codex-account {status|switch <name>|login <name>|toggle}\n' >&2
    exit 2
    ;;
esac
