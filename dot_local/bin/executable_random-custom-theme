#!/usr/bin/env bash
set -euo pipefail

themes_dir="${HOME}/.config/omarchy/custom-themes"
current=$(cat "${HOME}/.local/state/omarchy/current/theme.name" 2>/dev/null || true)

# Every custom theme except the current one, so each run visibly changes.
themes=()
while IFS= read -r theme; do
  [[ ${theme} == "${current}" ]] || themes+=("${theme}")
done < <(find -L "${themes_dir}" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null)

((${#themes[@]})) || exit 0

export THEME_KEEP_NAUTILUS=1
exec omarchy theme set "$(shuf -n 1 -e -- "${themes[@]}")"
