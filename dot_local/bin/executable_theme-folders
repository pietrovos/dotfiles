#!/usr/bin/env bash
set -uo pipefail

# A folder step in front of the Omarchy theme picker, shown in
# pietrovos.theme-picker, a clone of the stock picker. A folder is a directory
# in ~/.config/omarchy/theme-folders holding one empty file per theme, named
# after the theme, so yazi can organize them.

folders="${HOME}/.config/omarchy/theme-folders"
cache="${XDG_CACHE_HOME:-${HOME}/.cache}/omarchy/theme-folders"
covers="${cache}/covers"
contents="${cache}/contents"
resume="${cache}/resume"
user_themes="${HOME}/.config/omarchy/themes"
custom_themes="${HOME}/.config/omarchy/custom-themes"
stock_themes="${OMARCHY_PATH:-/usr/share/omarchy}/themes"
icon_font="CaskaydiaMono-NF-Regular"

# A second press must not close this picker and leave two loops fighting it.
mkdir -p "${folders}" "${covers}" "${contents}"
exec 9>"${cache}/lock"
flock -n 9 || exit 0

find_background() {
  [[ -d $1/backgrounds ]] || return
  find -L "$1/backgrounds" -maxdepth 1 -type f -iregex '.*\.\(png\|jpe?g\|webp\|gif\|bmp\)' -print 2>/dev/null | sort | head -n 1
}

find_preview() {
  local theme_path="$1" preview

  preview=$(find -L "${theme_path}" -maxdepth 1 -type f -iregex '.*/preview\.\(png\|jpe?g\|webp\|gif\|bmp\)' -print -quit 2>/dev/null)
  [[ -n ${preview} ]] || preview=$(find_background "${theme_path}")
  printf '%s' "${preview}"
}

all_themes() {
  find -L "${user_themes}" "${stock_themes}" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort -u
}

declare -A previews=()

load_previews() {
  local theme preview

  previews=()
  while IFS= read -r theme; do
    preview=""
    # Greenify and its replicas share one screenshot, so show their own wallpapers.
    [[ ${theme} == "greenify" || -d ${custom_themes}/${theme} ]] && preview=$(find_background "${user_themes}/${theme}")
    [[ -z ${preview} && -d ${user_themes}/${theme} ]] && preview=$(find_preview "${user_themes}/${theme}")
    [[ -z ${preview} && -d ${stock_themes}/${theme} ]] && preview=$(find_preview "${stock_themes}/${theme}")
    [[ -n ${preview} ]] && previews[${theme}]=${preview}
  done < <(all_themes)
}

# Replaces a cover only when its images change, because the picker rescans a
# folder whenever the folder's mtime moves.
write_collage() {
  local name="$1" tmp="${cache}/${1}.tmp.jpg" signature
  shift

  signature=$(printf '%s\n' "$@")
  if [[ -f ${covers}/${name}.jpg && $(cat "${cache}/${name}.signature" 2>/dev/null) == "${signature}" ]]; then
    return
  fi

  if (( $# == 0 )); then
    magick -size 1536x864 "xc:#15171c" -font "${icon_font}" -pointsize 300 -gravity center \
      -fill "#6b7280" -annotate 0 $'\U000f024b' -quality 85 "${tmp}"
  else
    magick montage "$@" -thumbnail 768x432^ -gravity center -extent 768x432 \
      -tile 2x2 -geometry +0+0 -background "#15171c" -quality 85 "${tmp}"
  fi
  mv -f "${tmp}" "${covers}/${name}.jpg"
  printf '%s' "${signature}" >"${cache}/${name}.signature"
}

write_organize_cover() {
  [[ -f ${covers}/Organize.jpg ]] && return
  magick -size 1536x864 "xc:#15171c" -font "${icon_font}" -pointsize 300 -gravity center \
    -fill "#d1d5db" -annotate 0 $'\U000f0256' -quality 85 "${cache}/Organize.tmp.jpg"
  mv -f "${cache}/Organize.tmp.jpg" "${covers}/Organize.jpg"
}

sync_contents() {
  local folder="$1" dir="${contents}/$1" theme preview link
  shift

  mkdir -p "${dir}"
  for link in "${dir}"/*; do
    [[ -L ${link} ]] || continue
    theme=${link##*/}
    theme=${theme%.*}
    # A new preview can change the extension, which would leave a duplicate.
    [[ " $* " == *" ${theme} "* && $(readlink "${link}") == "${previews[${theme}]:-}" ]] || rm -f "${link}"
  done

  for theme in "$@"; do
    preview=${previews[${theme}]}
    link="${dir}/${theme}.${preview##*.}"
    [[ $(readlink "${link}" 2>/dev/null) == "${preview}" ]] || ln -sfn "${preview}" "${link}"
  done
}

current_theme=$(cat "${HOME}/.local/state/omarchy/current/theme.name" 2>/dev/null)

build_folders() {
  local folder name theme marker
  local -a themes images
  local -A sorted=() kept=(All-Themes.jpg 1 Organize.jpg 1)

  load_previews

  for folder in "${folders}"/*/; do
    [[ -d ${folder} ]] || continue
    name=${folder%/}
    name=${name##*/}
    themes=()
    images=()

    for marker in "${folder}"*; do
      [[ -f ${marker} ]] || continue
      theme=${marker##*/}
      sorted[${theme}]=1
      [[ -n ${previews[${theme}]:-} ]] || continue
      themes+=("${theme}")
      images+=("${previews[${theme}]}")
    done

    sync_contents "${name}" "${themes[@]}"
    write_collage "${name}" "${images[@]:0:4}"
    kept[${name}.jpg]=1
  done

  # A newly installed theme stays reachable until it has been filed.
  themes=()
  images=()
  local -a everything=()
  while IFS= read -r theme; do
    [[ -n ${previews[${theme}]:-} ]] || continue
    everything+=("${theme}")
    (( ${#images[@]} < 4 )) && images+=("${previews[${theme}]}")
    [[ -z ${sorted[${theme}]:-} ]] && themes+=("${theme}")
  done < <(all_themes)
  sync_contents "All-Themes" "${everything[@]}"
  write_collage "All-Themes" "${images[@]}"

  if (( ${#themes[@]} > 0 )); then
    images=()
    for theme in "${themes[@]:0:4}"; do
      images+=("${previews[${theme}]}")
    done
    sync_contents "Unsorted" "${themes[@]}"
    write_collage "Unsorted" "${images[@]}"
    kept[Unsorted.jpg]=1
  fi

  write_organize_cover

  for marker in "${covers}"/*; do
    [[ -e ${marker} && -n ${kept[${marker##*/}]:-} ]] || rm -f "${marker}"
  done
}

# Rebuilding spawns a find per theme, too slow to run on every open.
refresh_folders() {
  local signature

  signature=$(stat -Lc '%n %Y' "${folders}" "${folders}"/*/ "${user_themes}" "${stock_themes}" \
    "${user_themes}"/* "${user_themes}"/*/backgrounds 2>/dev/null)
  [[ -f ${cache}/folders.signature && $(<"${cache}/folders.signature") == "${signature}" ]] && return

  build_folders
  printf '%s' "${signature}" >"${cache}/folders.signature"
}

# Sets action, picked and filter from how the picker was left. Thumbnails come
# from omarchy-menu-images, which leaves its rows in the cache.
pick() {
  local dir="$1" selected_path="$2" start_filter="$3" can_go_back="$4"
  local rows key selection_file done_file payload shell_pid

  omarchy-menu-images --cache-only "${dir}" >/dev/null 2>&1
  key=$(printf '%s' "${dir}" | md5sum | cut -d ' ' -f 1)
  rows=$(cat "${XDG_CACHE_HOME:-${HOME}/.cache}/omarchy/image-selector/${key}.rows" 2>/dev/null)
  [[ -n ${rows} ]] || rows=$(find -L "${dir}" -mindepth 1 -maxdepth 1 -type f -printf '%p\t%p\n' | sort)

  selection_file=$(mktemp)
  done_file=$(mktemp)
  rm -f "${done_file}"

  payload=$(jq -nc --arg rows "${rows}" --arg selected "${selected_path}" --arg selection "${selection_file}" \
    --arg done "${done_file}" --arg filter "${start_filter}" --argjson back "${can_go_back}" \
    '{imageRows: $rows, selectedImage: $selected, selectionFile: $selection, doneFile: $done,
      showLabels: true, filterable: true, filterText: $filter, canGoBack: $back}')

  action=""
  picked=""
  filter=""
  shell_pid=$(pgrep -nx quickshell)
  if [[ $(omarchy-shell shell summon pietrovos.theme-picker "${payload}") == "ok" ]]; then
    # A shell restart takes the picker with it and nothing would ever answer,
    # leaving this script holding the lock that blocks every later press.
    while [[ ! -e ${done_file} ]] && kill -0 "${shell_pid}" 2>/dev/null; do
      sleep 0.01
    done
    [[ -s ${selection_file} ]] && IFS=$'\t' read -r action picked filter <"${selection_file}"
  fi
  rm -f "${selection_file}" "${done_file}"
}

theme_link() {
  find "${contents}/$1" -maxdepth 1 -name "${current_theme}.*" -print -quit 2>/dev/null
}

refresh_folders

view="folders"
selected="${covers}/Unsorted.jpg"
marker=$(find "${folders}" -mindepth 2 -maxdepth 2 -name "${current_theme}" -print -quit 2>/dev/null)
if [[ -n ${marker} ]]; then
  marker=${marker%/*}
  selected="${covers}/${marker##*/}.jpg"
fi
filter=""

# Esc and applying a theme both leave a position to come back to.
if [[ -f ${resume} ]]; then
  IFS=$'\t' read -r saved_view saved_selected saved_filter <"${resume}"
  if [[ ${saved_view} == "folders" || -e ${covers}/${saved_view}.jpg ]]; then
    view=${saved_view}
    selected=${saved_selected}
    filter=${saved_filter}
  fi
fi

while true; do
  if [[ ${view} == "folders" ]]; then
    pick "${covers}" "${selected}" "${filter}" false
  else
    pick "${contents}/${view}" "${selected}" "${filter}" true
  fi

  case "${action}" in
    exit)
      printf '%s\t%s\t%s\n' "${view}" "${picked}" "${filter}" >"${resume}"
      exit 0
      ;;
    back)
      selected="${covers}/${view}.jpg"
      view="folders"
      filter=""
      ;;
    apply)
      choice=${picked##*/}
      choice=${choice%.*}
      if [[ ${view} != "folders" ]]; then
        printf '%s\t%s\t%s\n' "${view}" "${picked}" "${filter}" >"${resume}"
        exec 9>&-
        exec omarchy-theme-set "${choice}"
      elif [[ ${choice} == "Organize" ]]; then
        rm -f "${resume}"
        exec 9>&-
        exec omarchy-launch-tui yazi "${folders}"
      elif [[ -n $(find -L "${contents}/${choice}" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null) ]]; then
        view=${choice}
        selected=$(theme_link "${choice}")
        filter=""
      else
        # An empty folder has nothing to pick, so stay on its tile.
        selected=${picked}
      fi
      ;;
    *)
      exit 0
      ;;
  esac
done
