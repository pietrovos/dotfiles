#!/bin/bash
# Use Omarchy's recorder, but preview its output and discard it on close.
set -uo pipefail
umask 077

root="/dev/shm/omarchy-disposable-$UID"
[[ ! -L $root ]] || exit 1
mkdir -p "$root"
[[ -d $root && -O $root ]] || exit 1
chmod 700 "$root"

real_notify=$(command -v omarchy-notification-send)
active() { pgrep -f '^gpu-screen-recorder' >/dev/null; }
owned_session() { [[ $1 == "$root"/clip.* && ${1#"$root"/} != */* ]]; }

if [[ ${1:-} != --worker ]]; then
  exec 9>"$root/lock"
  if ! flock -n 9; then
    session=$(cat "$root/current" 2>/dev/null) || exit 0
    owned_session "$session" || exit 1
    if [[ $(cat "$root/phase" 2>/dev/null) == preview ]]; then
      hyprctl dispatch 'hl.dsp.focus({ window = "class:^(disposable-screenrecord-preview)$" })' >/dev/null
    else
      touch "$session/stop"
    fi
    exit 0
  fi
  if active; then
    exit 1
  fi
  # Only leftovers belonging to this wrapper are eligible for cleanup.
  previous=$(cat "$root/current" 2>/dev/null || true)
  if owned_session "$previous"; then rm -rf -- "$previous"; fi
  session=$(mktemp -d "$root/clip.XXXXXXXX")
  printf '%s\n' "$session" >"$root/current"
  printf 'starting\n' >"$root/phase"
  setsid "$0" --worker "$session" "${@}" 9>&9 >/dev/null 2>&1 &
  exit 0
fi

session=$2
owned_session "$session" || exit 1
shift 2
player=
recording=
dictating=false
transcriber=
started_id=
ended=false
export OMARCHY_SCREENRECORD_DIR="$session"

# This flow has exactly two toasts: our recording-started and recording-ended.
mkdir "$session/bin"
printf '#!/bin/bash\nexit 0\n' >"$session/bin/omarchy-notification-send"
chmod +x "$session/bin/omarchy-notification-send"
export PATH="$session/bin:$PATH"

dictation_state() {
  voxtype status --format json 2>/dev/null | jq -r '.class // "unavailable"'
}

start_dictation() {
  # Do not hijack an F9 dictation that was already in progress.
  [[ $(dictation_state) == idle ]] || return 0
  voxtype record start --file="$session/transcript.txt" --no-osd --no-auto-submit \
    --no-smart-auto-submit >/dev/null 2>&1 || return 0
  dictating=true
  for ((j=0; j<50; j++)); do
    [[ $(dictation_state) == recording ]] && return 0
    sleep 0.05 9>&-
  done
}

stop_dictation() {
  [[ $dictating == true && -z $transcriber ]] || return 0
  # One stop that also waits: a second `stop --wait` issued after the first
  # stop finds the daemon idle and reports "empty", losing the transcript.
  # It runs in the background so transcription overlaps native finalization.
  voxtype record stop --wait --json --wait-file "$session/transcript.txt" \
    --timeout 300 >"$session/transcription.json" 2>/dev/null 9>&- &
  transcriber=$!
}

finish_dictation() {
  [[ $dictating == true ]] || return 0
  stop_dictation
  # Completion barrier: the preview cannot steal focus while Voxtype is still
  # transcribing, and the text is typed into the app that was focused.
  wait "$transcriber" 2>/dev/null || true
  transcriber=
  dictating=false
  local text
  text=$(jq -r 'select(.status == "ok") | .text // empty' "$session/transcription.json" 2>/dev/null)
  if [[ -n $text ]]; then wtype -d 1 -- "$text" 9>&-; fi
}

cleanup() {
  trap - EXIT INT TERM HUP
  if [[ -n $player ]]; then kill "$player" 2>/dev/null || true; wait "$player" 2>/dev/null || true; fi
  if [[ -n $transcriber ]]; then kill "$transcriber" 2>/dev/null || true; fi
  if [[ $dictating == true ]]; then
    voxtype record cancel >/dev/null 2>&1 || true
  fi
  # Never fail silently: a missing "started" cue must not look like a slow one.
  if [[ $ended != true && ! -e $session/stop ]]; then
    "$real_notify" -u critical -t 4000 -r "${started_id:-0}" \
      "Disposable recording" "Recording failed." 9>&- || true
  fi
  # Never stop a normal recording belonging to another Omarchy invocation.
  if [[ -n $recording && $(cat /tmp/omarchy-screenrecord-filename 2>/dev/null) == "$recording" ]] && active; then
    omarchy screenrecord --stop-recording >/dev/null 2>&1 9>&- || true
  fi
  rm -rf -- "$session"
  rm -f -- "$root/current" "$root/phase"
}
trap cleanup EXIT
trap 'exit 0' INT TERM HUP

if active; then
  exit 1
fi

# Scope monitor selection to this invocation without changing desktop focus or
# modifying Omarchy. Its native recorder/overlay/finalizer still do the work.
monitor=$(hyprctl monitors -j | jq -cer 'first(.[] | select(.model | test("MSI"; "i"))) // empty')
if [[ -z $monitor ]]; then
  exit 1
fi
monitor_name=$(jq -r '.name' <<<"$monitor")
anchor=$(jq -r '[((.width / .scale) | floor), ((.height / .scale) | floor), .x, .y] | "\(.[0])x\(.[1])+\(.[2])+\(.[3])"' <<<"$monitor")
printf '#!/bin/bash\nprintf "%%s\\n" %q\n' "$monitor_name" \
  >"$session/bin/omarchy-hyprland-monitor-focused"
real_resize=$(command -v omarchy-capture-webcam-resize)
# The overlay maps on the focused monitor. Moving it only by pixels leaves it
# owned by that monitor while drawn on the MSI, and its picture froze for the
# whole recording; hand it to the MSI first, then let Omarchy size/place it.
cat >"$session/bin/omarchy-capture-webcam-resize" <<EOF
#!/bin/bash
printf '%s\n' $(printf %q "$anchor") >"\${XDG_RUNTIME_DIR:-/tmp}/omarchy-screenrecord-region"
address=\$(hyprctl clients -j | jq -r 'first(.[] | select(.title == "WebcamOverlay") | .address) // empty')
if [[ -n \$address ]]; then
  hyprctl dispatch "hl.dsp.window.move({ window = \\"address:\$address\\", monitor = \\"$monitor_name\\" })" >/dev/null 2>&1
fi
exec $(printf %q "$real_resize") "\$@"
EOF
chmod +x "$session/bin/omarchy-hyprland-monitor-focused" "$session/bin/omarchy-capture-webcam-resize"

omarchy screenrecord --fullscreen --resolution=0x0 --with-microphone-audio --with-webcam 9>&- || exit 1
recording=$(cat /tmp/omarchy-screenrecord-filename 2>/dev/null || true)
if [[ $recording != "$session"/screenrecording-*.mp4 || ! -f $recording ]]; then
  exit 1 # Picker cancelled or native recorder failed to start.
fi
# gpu-screen-recorder creates the file with its first frame (measured: file
# age matches clip duration within ~30ms), and Omarchy only returns once it
# exists. Its later growth is 256KB write-buffer flushes, which track bitrate
# rather than readiness, so waiting on size made the cue late and erratic.
# Start dictation now so it catches the first words, then get past the
# finalizer's 0.1s trim, first-400ms audio mute and 50ms fade before the cue.
start_dictation
sleep 0.6 9>&-
active || exit 1
[[ ! -e $session/stop ]] || exit 0
printf 'recording\n' >"$root/phase"
started_id=$("$real_notify" -p -u normal -t 3000 "Disposable recording" "Recording started." 9>&-) || started_id=

while active && [[ ! -e $session/stop ]]; do
  available=$(df -Pk "$session" | awk 'NR == 2 {print $4}')
  if [[ ${available:-0} -lt 262144 ]]; then
    break
  fi
  sleep 0.25 9>&-
done
printf 'stopping\n' >"$root/phase"
# Stop mic dictation now, rather than recording the native finalizer's delay.
stop_dictation
if active; then
  omarchy screenrecord --stop-recording >/dev/null 9>&- || exit 1
else
  # If stopped via Omarchy's bar/other shortcut, let its finalizer finish first.
  for ((i=0; i<600; i++)); do
    [[ $(cat /tmp/omarchy-screenrecord-filename 2>/dev/null) != "$recording" ]] && break
    sleep 0.1 9>&-
  done
fi
[[ -s $recording ]] || exit 1
ended=true
"$real_notify" -u normal -t 3000 -r "${started_id:-0}" "Disposable recording" "Recording ended." 9>&- || true
finish_dictation

printf 'preview\n' >"$root/phase"
mpv --no-config --no-resume-playback --save-position-on-quit=no \
  --keep-open=yes --force-window=yes --loop-file=inf \
  --title='Disposable recording — close to discard' \
  --wayland-app-id=disposable-screenrecord-preview \
  --input-ipc-server="$session/preview.sock" -- "$recording" 9>&- &
player=$!
wait "$player" || true
player=
