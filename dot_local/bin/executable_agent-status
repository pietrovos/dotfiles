#!/usr/bin/env bash
set -uo pipefail

# Marks the Hyprland window hosting a coding agent as running, asking a
# question or done, for the bar (pietrovos.workspaces and group-tabs): a ring
# while it works, a question mark until it is answered, a checkmark once it
# finishes. Called from Claude Code hooks and OpenCode's completion plugin.
#
# Usage: agent-status running|question|done|clear|resume [pid]
# The window is found by walking up from pid (default: the caller). resume
# turns a question back into running; it runs after every Claude tool call, so
# it returns at once when no window is waiting on a question.

state=${1:-}
pid=${2:-$PPID}
dir="${XDG_STATE_HOME:-${HOME}/.local/state}/omarchy/agent-marks"

[[ ${state} == @(running|question|done|clear|resume) ]] || exit 2
mkdir -p "${dir}"
if [[ ${state} == resume ]]; then
  grep -qlx question "${dir}"/0x* 2>/dev/null || exit 0
fi
clients=$(hyprctl clients -j 2>/dev/null) || exit 0

address=""
for _ in $(seq 1 10); do
  address=$(jq -r --argjson pid "${pid}" 'map(select(.pid == $pid)) | first | .address // empty' <<<"${clients}")
  [[ -n ${address} ]] && break
  pid=$(ps -o ppid= -p "${pid}" 2>/dev/null | tr -d ' ')
  [[ -z ${pid} || ${pid} -le 1 ]] && break
done

# Marks of windows that have since closed go with them.
for mark in "${dir}"/0x*; do
  [[ -e ${mark} ]] || continue
  jq -e --arg address "${mark##*/}" 'any(.[]; .address == $address)' <<<"${clients}" >/dev/null || rm -f "${mark}"
done

[[ -n ${address} ]] || exit 0
if [[ ${state} == clear ]]; then
  rm -f "${dir}/${address}"
elif [[ ${state} == resume ]]; then
  [[ $(cat "${dir}/${address}" 2>/dev/null) == question ]] || exit 0
  printf 'running\n' >"${dir}/${address}"
else
  printf '%s\n' "${state}" >"${dir}/${address}"
fi

# The bar watches this file to refresh straight away.
date +%s%N >"${dir}/changed"
