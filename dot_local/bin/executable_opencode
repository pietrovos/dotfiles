#!/bin/bash
# Launchers outside an activated shell (e.g. the Hyprland duplicate binding) reach mise's OpenCode through this shim.
bin="${XDG_DATA_HOME:-${HOME}/.local/share}/mise/shims/opencode"

# Interactive launches attach to the always-on server (opencode-server.service) so sessions are reachable from other devices.
# Falls back to a plain local session when the server is down.
server=http://100.117.174.8:4096
env_file="${XDG_CONFIG_HOME:-${HOME}/.config}/opencode/server.env"
if [[ $# -eq 0 || $1 == -c || $1 == --continue || $1 == -s || $1 == --session ]] && [[ -r $env_file ]]; then
  set -a; . "$env_file"; set +a
  if curl -fs -o /dev/null --max-time 1 -u "opencode:${OPENCODE_SERVER_PASSWORD}" "${server}/api/session"; then
    exec "$bin" attach "$server" --dir "$PWD" "$@"
  fi
fi
exec "$bin" "$@"
