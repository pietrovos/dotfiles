#!/usr/bin/env node
// F10 toggles an isolated OBS recording; closing its mpv preview discards it.
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import net from 'node:net';
import crypto from 'node:crypto';
import { spawn, spawnSync } from 'node:child_process';
import { once } from 'node:events';
import { fileURLToPath } from 'node:url';

process.umask(0o077);
const root = `/dev/shm/obs-disposable-${process.getuid()}`;
fs.mkdirSync(root, { recursive: true, mode: 0o700 });
const info = fs.lstatSync(root);
if (!info.isDirectory() || info.isSymbolicLink() || info.uid !== process.getuid()) {
  throw new Error('Unsafe disposable recording directory');
}
fs.chmodSync(root, 0o700);
const control = path.join(root, 'control.sock');
const sleep = ms => new Promise(resolve => setTimeout(resolve, ms));
const notify = (message, urgent = false) => spawnSync('notify-send', [
  '-a', 'Disposable recording', '-u', urgent ? 'critical' : 'normal',
  'Webcam recording', message,
], { stdio: 'ignore' });

function contact(command) {
  return new Promise((resolve, reject) => {
    const socket = net.createConnection(control);
    let result = '';
    socket.setTimeout(3000, () => socket.destroy(new Error('Recorder not responding')));
    socket.on('connect', () => socket.write(command + '\n'));
    socket.on('data', chunk => { result += chunk; });
    socket.on('end', () => resolve(result.trim()));
    socket.on('error', reject);
  });
}

class ObsConnection {
  constructor(socket) {
    this.socket = socket;
    this.pending = new Map();
    socket.addEventListener('message', event => {
      const { op, d } = JSON.parse(event.data);
      if (op !== 7) return;
      const pending = this.pending.get(d.requestId);
      if (!pending) return;
      this.pending.delete(d.requestId);
      clearTimeout(pending.timer);
      if (d.requestStatus.result) pending.resolve(d.responseData || {});
      else pending.reject(new Error(`${d.requestType}: ${d.requestStatus.comment || d.requestStatus.code}`));
    });
    socket.addEventListener('close', () => {
      for (const p of this.pending.values()) {
        clearTimeout(p.timer);
        p.reject(new Error('OBS disconnected'));
      }
      this.pending.clear();
    });
  }

  static connect(port, password) {
    return new Promise((resolve, reject) => {
      const socket = new WebSocket(`ws://127.0.0.1:${port}`);
      const fail = error => { clearTimeout(timer); socket.close(); reject(error); };
      const timer = setTimeout(() => fail(new Error('OBS handshake timed out')), 2000);
      socket.addEventListener('error', () => fail(new Error('OBS not ready')));
      socket.addEventListener('message', function handshake(event) {
        const { op, d } = JSON.parse(event.data);
        if (op === 0) {
          const identify = { rpcVersion: 1, eventSubscriptions: 0 };
          if (d.authentication) {
            const hash = text => crypto.createHash('sha256').update(text).digest('base64');
            identify.authentication = hash(hash(password + d.authentication.salt) + d.authentication.challenge);
          }
          socket.send(JSON.stringify({ op: 1, d: identify }));
        } else if (op === 2) {
          clearTimeout(timer);
          socket.removeEventListener('message', handshake);
          resolve(new ObsConnection(socket));
        }
      });
    });
  }

  request(requestType, requestData = {}) {
    const requestId = crypto.randomUUID();
    return new Promise((resolve, reject) => {
      const timer = setTimeout(() => {
        this.pending.delete(requestId);
        reject(new Error(`${requestType} timed out`));
      }, 15000);
      this.pending.set(requestId, { resolve, reject, timer });
      this.socket.send(JSON.stringify({ op: 6, d: { requestType, requestData, requestId } }));
    });
  }
}

async function terminate(child) {
  if (!child || child.exitCode !== null || child.signalCode !== null) return;
  child.kill('SIGTERM');
  const finished = once(child, 'exit');
  let timeout;
  await Promise.race([finished, new Promise(resolve => { timeout = setTimeout(resolve, 5000); })]);
  clearTimeout(timeout);
  if (child.exitCode === null && child.signalCode === null) {
    child.kill('SIGKILL');
    await finished;
  }
}

async function daemon() {
  let phase = 'starting', session, obs, player, rpc, monitor, cleaning = false;
  const server = net.createServer(socket => {
    socket.once('data', data => {
      const command = data.toString().trim();
      socket.end(JSON.stringify({ phase, session, pid: process.pid }) + '\n');
      if (command === 'status') return;
      if (phase === 'recording') void stop().catch(fail);
      else if (phase === 'preview') {
        spawnSync('hyprctl', ['dispatch', 'hl.dsp.focus({ window = "class:^(obs-disposable-preview)$" })'], { stdio: 'ignore' });
      } else notify(phase === 'starting' ? 'Starting OBS—wait for the recording notification.' : 'Finishing the recording…');
    });
  });
  server.listen(control);
  await once(server, 'listening');

  async function cleanup() {
    if (cleaning) return;
    cleaning = true;
    phase = 'closing';
    clearInterval(monitor);
    rpc?.socket.close();
    await terminate(player);
    await terminate(obs);
    if (session) fs.rmSync(session, { recursive: true, force: true });
    server.close();
    process.exit(0);
  }
  async function fail(error) {
    if (cleaning) return;
    console.error(error);
    const log = session && path.join(session, 'obs.log');
    fs.writeFileSync(path.join(root, 'last-error.log'), String(error) + '\n' +
      (log && fs.existsSync(log) ? fs.readFileSync(log, 'utf8').slice(-40000) : ''));
    notify(`Recording discarded: ${error.message}`, true);
    await cleanup();
  }
  process.on('SIGTERM', () => void cleanup());
  process.on('SIGINT', () => void cleanup());
  process.on('uncaughtException', error => void fail(error));
  process.on('unhandledRejection', error => void fail(error));

  async function stop() {
    phase = 'stopping';
    clearInterval(monitor);
    const { outputPath } = await rpc.request('StopRecord');
    if (!outputPath || !fs.realpathSync(outputPath).startsWith(session + '/')) {
      throw new Error('OBS returned an unexpected recording path');
    }
    rpc.socket.close();
    await terminate(obs); // Release the camera and mic before playback.
    phase = 'preview';
    player = spawn('mpv', [
      '--no-config', '--no-resume-playback', '--save-position-on-quit=no',
      '--keep-open=yes', '--force-window=yes', '--loop-file=inf',
      '--title=Disposable recording — close to discard', '--wayland-app-id=obs-disposable-preview',
      `--input-ipc-server=${session}/preview.sock`, '--', outputPath,
    ], { stdio: 'ignore' });
    player.on('error', error => void fail(error));
    player.on('exit', () => {
      if (!cleaning) {
        notify('Preview closed. Recording deleted.');
        void cleanup();
      }
    });
    notify('Preview ready. Close it (or press Q) to delete the recording.');
  }

  try {
    const devices = fs.existsSync('/dev/v4l/by-id')
      ? fs.readdirSync('/dev/v4l/by-id').filter(name => name.endsWith('-video-index0')) : [];
    const camera = process.env.OBS_DISPOSABLE_CAMERA || (devices.length
      ? `/dev/v4l/by-id/${devices[0]}` : '/dev/video0');
    fs.accessSync(camera, fs.constants.R_OK | fs.constants.W_OK);
    session = fs.mkdtempSync(path.join(root, 'session-'));
    const config = path.join(session, 'config');
    const base = path.join(config, 'obs-studio');
    function write(relative, content) {
      const target = path.join(base, relative);
      fs.mkdirSync(path.dirname(target), { recursive: true });
      fs.writeFileSync(target, content);
    }
    const password = crypto.randomBytes(24).toString('base64');
    const probe = net.createServer();
    probe.listen(0, '127.0.0.1');
    await once(probe, 'listening');
    const port = probe.address().port;
    await new Promise(resolve => probe.close(resolve));
    write('plugin_config/obs-websocket/config.json', JSON.stringify({
      alerts_enabled: false, auth_required: true, first_load: false,
      server_enabled: true, server_password: password, server_port: port,
    }));
    write('global.ini', '[General]\nEnableAutoUpdates=false\n[Video]\nRenderer=OpenGL\n');
    write('user.ini', '[General]\nFirstRun=true\nPre19Defaults=false\nPre21Defaults=false\nPre23Defaults=false\nPre24.1Defaults=false\nConfirmOnExit=false\n[Basic]\nProfile=Disposable\nProfileDir=Disposable\nSceneCollection=Disposable\nSceneCollectionFile=Disposable\n[BasicWindow]\nSysTrayEnabled=true\nSysTrayWhenStarted=true\nWarnBeforeStartingRecord=false\nWarnBeforeStoppingRecord=false\n');
    write('basic/profiles/Disposable/basic.ini', `[General]\nName=Disposable\n[Video]\nBaseCX=1280\nBaseCY=720\nOutputCX=1280\nOutputCY=720\nFPSType=0\nFPSCommon=30\n[Audio]\nSampleRate=48000\nChannelSetup=Stereo\n[Output]\nMode=Simple\nFilenameFormatting=recording\n[SimpleOutput]\nFilePath=${session}\nRecFormat2=mkv\nRecQuality=Small\nRecEncoder=x264\nRecAudioEncoder=aac\nStreamAudioEncoder=aac\nABitrate=160\n`);
    write('basic/scenes/Disposable.json', JSON.stringify({
      name: 'Disposable', sources: [], groups: [], scene_order: [],
      current_scene: '', current_program_scene: '', transitions: [], version: 2,
    }));
    const log = fs.openSync(path.join(session, 'obs.log'), 'a', 0o600);
    obs = spawn('obs', ['--multi', '--only-bundled-plugins', '--minimize-to-tray',
      '--disable-missing-files-check', '--profile', 'Disposable', '--collection', 'Disposable'], {
      env: { ...process.env, XDG_CONFIG_HOME: config, XDG_CACHE_HOME: `${session}/cache` },
      stdio: ['ignore', log, log],
    });
    fs.closeSync(log);
    obs.on('error', error => void fail(error));
    obs.on('exit', () => {
      if (!cleaning && ['starting', 'recording'].includes(phase)) void fail(new Error('OBS exited unexpectedly'));
    });
    for (let attempt = 0; attempt < 80; attempt++) {
      if (obs.exitCode !== null) throw new Error('OBS failed to start');
      try { rpc = await ObsConnection.connect(port, password); break; }
      catch { await sleep(250); }
    }
    if (!rpc) throw new Error('Could not connect to the isolated OBS instance');
    const { scenes } = await rpc.request('GetSceneList');
    const sceneName = scenes[0]?.sceneName || 'Disposable';
    if (!scenes.length) await rpc.request('CreateScene', { sceneName });
    await rpc.request('SetCurrentProgramScene', { sceneName });
    const webcam = await rpc.request('CreateInput', {
      sceneName, inputName: 'Webcam', inputKind: 'v4l2_input',
      inputSettings: { device_id: camera, pixelformat: 1196444237,
        resolution: 1280 * 2 ** 32 + 720, framerate: 2 ** 32 + 30, buffering: true,
        timeout_frames: 120 },
    });
    await rpc.request('SetSceneItemTransform', {
      sceneName, sceneItemId: webcam.sceneItemId,
      sceneItemTransform: { boundsType: 'OBS_BOUNDS_SCALE_INNER', boundsWidth: 1280,
        boundsHeight: 720, positionX: 0, positionY: 0, alignment: 5, boundsAlignment: 0 },
    });
    await rpc.request('CreateInput', {
      sceneName, inputName: 'Microphone', inputKind: 'pulse_input_capture',
      inputSettings: { device_id: 'default' },
    });
    // The C270 needs a few seconds to deliver its first frames after opening.
    // Warm up before recording instead of putting that black lead-in in the clip.
    await sleep(3500);
    // Fresh scene collection: no desktop audio or display capture is included.
    await rpc.request('SetRecordDirectory', { recordDirectory: session });
    await rpc.request('StartRecord');
    let started = false;
    for (let attempt = 0; attempt < 100; attempt++) {
      const status = await rpc.request('GetRecordStatus');
      if (status.outputActive && status.outputDuration > 0) { started = true; break; }
      await sleep(100);
    }
    if (!started) throw new Error('OBS did not begin recording');
    fs.rmSync(path.join(root, 'last-error.log'), { force: true });
    phase = 'recording';
    notify('Recording webcam + default microphone. Press F10 to stop and preview.');
    let checking = false;
    monitor = setInterval(async () => {
      if (checking || phase !== 'recording') return;
      checking = true;
      try {
        const space = fs.statfsSync(session);
        if (space.bavail * space.bsize < 256 * 1024 ** 2) {
          notify('Temporary storage nearly full. Stopping and opening preview.', true);
          await stop();
        } else {
          const status = await rpc.request('GetRecordStatus');
          if (!status.outputActive) throw new Error('OBS recording stopped unexpectedly');
        }
      } catch (error) { if (phase === 'recording') await fail(error); }
      finally { checking = false; }
    }, 2000);
  } catch (error) { await fail(error); }
}

if (process.argv.includes('--daemon')) {
  await daemon();
} else {
  const command = process.argv.includes('--status') ? 'status' : 'toggle';
  try { console.log(await contact(command)); }
  catch (error) {
    if (!['ECONNREFUSED', 'ENOENT'].includes(error.code)) throw error;
    if (command === 'status') { console.log('idle'); process.exit(0); }
    // A dead daemon can leave its socket behind; only remove that exact socket.
    try { if (fs.lstatSync(control).isSocket()) fs.unlinkSync(control); }
    catch (error) { if (error.code !== 'ENOENT') throw error; }
    const child = spawn(process.execPath, [fileURLToPath(import.meta.url), '--daemon'], {
      detached: true, stdio: 'ignore',
    });
    child.unref();
  }
}
