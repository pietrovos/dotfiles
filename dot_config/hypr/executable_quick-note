#!/bin/bash
# Open a new blank note in nvim inside a floating terminal, ready to type.
# If a quick note is already open, focus it instead of opening another.

notes_dir="$HOME/Quick Notes"

address=$(hyprctl clients -j | jq -r '.[] | select(.class == "quicknote") | .address' | head -n1)
if [[ -n $address ]]; then
  exec hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })" >/dev/null
fi

# Drop quick notes that were opened but never written in (autosave can leave a
# lone newline, so whitespace-only counts as empty).
mkdir -p "$notes_dir"
find "$notes_dir" -maxdepth 1 -name '*.md' -type f ! -exec grep -q '[^[:space:]]' {} \; -delete

# Seconds keep two notes in the same minute apart; a counter covers the rest.
note="$notes_dir/$(date '+%F %H-%M-%S').md"
n=2
while [[ -e $note ]]; do
  note="$notes_dir/$(date '+%F %H-%M-%S') $((n++)).md"
done
touch "$note"

# Closing the window kills nvim, so save on every change instead of keeping a
# swap file (-n) that would be left behind and warn on the next open.
# Start in the notes folder so ":w name" and ":saveas" land there too.
exec setsid uwsm-app -- kitty --class=quicknote --title="Quick note" --directory="$notes_dir" \
  nvim -n -c "setlocal wrap linebreak" \
  -c "autocmd TextChanged,TextChangedI,InsertLeave <buffer> silent! update" \
  +startinsert "$note" >/dev/null 2>&1
