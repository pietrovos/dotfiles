#!/bin/bash

cwd=$(omarchy-cmd-terminal-cwd)

# kitty directly (not xdg-terminal-exec) so Claude windows can use white body
# text: Claude Code draws reply text in the terminal's default foreground,
# which the Greenify theme makes green.
exec setsid uwsm-app -- kitty --class=org.omarchy.claude --directory="$cwd" -o foreground=#eeeeee -e /home/pietrovos/.local/bin/claude --remote-control
