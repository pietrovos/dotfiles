{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "opencode"
  },
  "keybinds": {
    "app.toggle.paste_summary": "<leader>v",
    "session.new": "<leader>n,ctrl+t",
    "variant.cycle": "none",
    "input.delete.word.backward": "ctrl+backspace,alt+backspace",
    "session.tab.close": "ctrl+w"
  },
  "attention": {
    "notifications": false
  },
  "diffs": {
    "wrap": "word"
  },
  "prompt": {
    "paste": "full"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "markdown": "rendered",
    "image_preview": true
  },
  "tabs": {
    "mode": "off",
    "layout": "horizontal",
    "indicators": "status"
  },
  "animations": true,
  "plugins": [
    "./cli-plugins/completion-notification",
    "./cli-plugins/restart",
    "./cli-plugins/keybinds",
    "./cli-plugins/toggle-tabs"
  ]
}
