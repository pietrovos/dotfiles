{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "opencode"
  },
  "keybinds": {
    "app.toggle.paste_summary": "<leader>v",
    "session.new": "<leader>n,ctrl+t",
    "variant.cycle": "none"
  },
  "attention": {
    "notifications": false
  },
  "diffs": {
    "wrap": "word"
  },
  "prompt": {
    "paste": "full"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide"
  },
  "animations": true,
  "plugins": ["./cli-plugins/completion-notification", "./cli-plugins/restart"]
}
