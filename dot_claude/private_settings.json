{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh finished",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.local/bin/agent-status done",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh question",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.local/bin/agent-status question",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh question",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.local/bin/agent-status question",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/agent-status running",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/agent-status clear",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/agent-status resume",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "my-highlights@pietrovos-mods": true
  },
  "extraKnownMarketplaces": {
    "pietrovos-mods": {
      "source": {
        "source": "directory",
        "path": "/home/pietrovos/.claude/mods"
      }
    }
  },
  "autoUpdatesChannel": "stable",
  "theme": "custom:lucent-orng",
  "preferredNotifChannel": "notifications_disabled",
  "agentPushNotifEnabled": true
}
